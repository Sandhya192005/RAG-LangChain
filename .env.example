OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-5.6-luna
EMBED_MODEL=text-embedding-3-small
# Leave blank for models that only allow the default temperature (e.g. GPT-5 family); set 0 for older models like gpt-4o-mini
CHAT_TEMPERATURE=

# PostgreSQL + pgvector running in Docker (see docker-compose.yml)
PG_HOST=localhost
PG_PORT=5433
PG_DB=resume_rag
PG_USER=rag
PG_PASSWORD=choose-a-password
# Where retrieve.py searches: numpy (index/ files) or postgres
VECTOR_STORE=postgres
